FROM qwen3.5:9b

# OMP worker prompts start near 9k tokens, and compaction reserves 8,192
# tokens (compaction.reserveTokens). At 32,768 a Vibe worker compacted up to
# 27 times per task; 65,536 leaves room for multi-file tasks. On the reference
# 8 GB GPU this runs 36% CPU / 64% GPU at about 10 output tokens per second.
PARAMETER num_ctx 65536

# Qwen3.5 recommended sampling for thinking-mode coding.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER presence_penalty 0
